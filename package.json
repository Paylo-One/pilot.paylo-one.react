{
  "name": "pilot-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "description": "Pilot — a multi-tenant, self-hostable personal intelligence workspace with cited briefings and explicit integration boundaries.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run modules/identity-tenant/tenant-isolation.integration.test.ts",
    "check:oss": "node scripts/check-oss-readiness.mjs",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "dependencies": {
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.47.10",
    "inngest": "^4.18.0",
    "next": "16.2.12",
    "next-intl": "^4.13.2",
    "openai": "^4.77.0",
    "react": "19.2.8",
    "react-dom": "19.2.7",
    "react-icons": "^5.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "audit-ci": "^7.1.0",
    "@types/node": "^22",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": {
      "minimatch": {
        "brace-expansion": "1.1.18"
      }
    },
    "glob": {
      "minimatch": {
        "brace-expansion": "2.1.4"
      }
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "10.2.6"
    },
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "^8.5.18",
    "form-data": "^4.0.6",
    "sharp": "^0.35.3"
  }
}

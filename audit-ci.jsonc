{
  // Dependency-vulnerability gate for CI (replaces bare `npm audit`).
  //
  // Enforce the release-readiness "zero known vulnerabilities" bar on high and
  // critical advisories across all dependencies. Moderate/low noise does not
  // block PRs.
  "high": true,

  // Documented, justified exceptions. Keep this list empty unless a
  // time-bounded exception has explicit rationale and revert criteria.
  "allowlist": []
}

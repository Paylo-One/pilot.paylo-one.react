# Paylo.one Management OS — application scaffold
# Copy to `.env.local` and fill in. This scaffold makes NO live calls; these
# values are documented for future implementation only. Only secrets belong in
# env vars — non-sensitive configuration lives in code/config modules.

# --- Platform / routing -----------------------------------------------------
# Registrable apex used for tenant subdomain resolution (see proxy.ts).
NEXT_PUBLIC_APP_APEX=paylo.one
# Local subdomain testing host (e.g. lvh.me resolves *.lvh.me -> 127.0.0.1).
NEXT_PUBLIC_DEV_APEX=lvh.me

# --- Supabase (Postgres + Auth + Storage + pgvector) ------------------------
# Use the NEW API keys (publishable + secret), NOT the legacy anon/service_role
# keys (those are compatibility-only). See the supabase skill, Principle #6.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe to expose to the browser; replaces
# the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET — server/worker code only (sb_secret_...). Authenticates as the
# service_role Postgres role and BYPASSES RLS; never import into client bundles.
# Replaces the legacy service_role key.
SUPABASE_SECRET_KEY=

# --- Model Gateway providers (server-side only; scaffold does not call them) -
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
GOOGLE_API_KEY=
# Private vLLM runtime endpoint (later; off-platform, never tenant-facing).
VLLM_BASE_URL=

# --- Workflow orchestration (Inngest; not wired in scaffold) -----------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

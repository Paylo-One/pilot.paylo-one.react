# Paylo.one Management OS — application environment
# Copy to `.env.local` and fill in. Only secrets belong in env vars —
# non-sensitive configuration lives in code/config modules. Sections marked
# "not wired" are documented for future implementation and never read.

# --- Platform / routing -----------------------------------------------------
# Registrable apex used for tenant subdomain resolution (see proxy.ts).
NEXT_PUBLIC_APP_APEX=paylo.one
# Local subdomain testing host (e.g. lvh.me resolves *.lvh.me -> 127.0.0.1).
NEXT_PUBLIC_DEV_APEX=lvh.me

# --- Supabase (Postgres + Auth + Storage + pgvector) ------------------------
# Use the NEW API keys (publishable + secret), NOT the legacy anon/service_role
# keys (those are compatibility-only). See the supabase skill, Principle #6.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe to expose to the browser; replaces
# the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET — server/worker code only (sb_secret_...). Authenticates as the
# service_role Postgres role and BYPASSES RLS; never import into client bundles.
# Replaces the legacy service_role key.
SUPABASE_SECRET_KEY=

# --- Model Gateway providers (server-side only; scaffold does not call them) -
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
GOOGLE_API_KEY=
# Private vLLM runtime endpoint (later; off-platform, never tenant-facing).
VLLM_BASE_URL=

# --- WhatsApp Web-session bridge (ADR-036; off by default) -------------------
# The bridge is a separate runtime (whatsapp-bridge/) deployed OUTSIDE
# Vercel/Supabase on a private network. With the flag off, the WhatsApp card
# runs the persisted scaffold (simulated scan, mock discovery) and none of the
# other values are read. Production enablement stays gated on the ADR-036
# ToS/legal/platform validation.
WHATSAPP_BRIDGE_ENABLED=false
# Private base URL of the bridge runtime (app -> bridge). The bridge listens on
# PORT 8088 by default, so locally: http://localhost:8088
WHATSAPP_BRIDGE_BASE_URL=
# Bearer the app presents to the bridge on every request.
# MUST equal the bridge's BRIDGE_AUTH_TOKEN. Generate: openssl rand -hex 32
WHATSAPP_BRIDGE_AUTH_TOKEN=
# Shared secret for the bridge's callbacks INTO the app (message webhook +
# session-material store), verified as bearer + HMAC-SHA256 body signature.
# MUST equal the bridge's APP_CALLBACK_TOKEN. Generate: openssl rand -hex 32
WHATSAPP_BRIDGE_CALLBACK_TOKEN=
# NOTE (bridge side): the bridge's APP_BASE_URL must use a host the app's proxy
# recognises — locally that is http://lvh.me:3000 (NOT localhost:3000, which the
# host allowlist rejects with a 404).


# --- Source integrations (OAuth apps; a connector shows "Needs credentials"
# --- until its pair is set) ---------------------------------------------------
# GitHub OAuth app (read-only repository monitoring).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Google OAuth app (Gmail + Calendar, read-only).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft Entra app registration (MS 365 Mail + Teams via Graph, read-only;
# ADR-027/037). Redirect URI: https://app.<apex>/api/oauth/microsoft/callback
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Entra authority tenant segment. Default "organizations" (any work/school
# account); pin to a directory (tenant) ID for single-org installs.
MICROSOFT_OAUTH_TENANT=
# Slack OAuth app (public channel monitoring first, read-only). Redirect URI:
# https://app.<apex>/api/oauth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Discord OAuth2 application + bot install. Redirect URI:
# https://app.<apex>/api/oauth/discord/callback. Enable Message Content intent
# in the Developer Portal when message text should be ingested.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# --- Workflow orchestration (Inngest; not wired in scaffold) -----------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- News Briefing background ingestion (ADR-039) ---------------------------
# SECRET bearer used only by POST /api/news/ingest (cron/internal callers).
# Generate with: openssl rand -hex 32
NEWS_INGESTION_TOKEN=
